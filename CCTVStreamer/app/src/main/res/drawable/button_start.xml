<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when button is disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#B0BEC5" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#90A4AE" />
        </shape>
    </item>
    
    <!-- State when button is pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#0D47A1" />
        </shape>
    </item>
    
    <!-- State when button is focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1976D2" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#0D47A1" />
        </shape>
    </item>
    
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1976D2" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#1565C0" />
        </shape>
    </item>
</selector>